{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@mity-garden/domain": ["../../packages/domain/src/index.ts"],
      "@mity-garden/domain/*": ["../../packages/domain/src/*"],
      "@mity-garden/i18n": ["../../packages/i18n/src/index.ts"],
      "@mity-garden/i18n/*": ["../../packages/i18n/src/*"],
      "@mity-garden/asset-library": ["../../packages/asset-library/src/index.ts"],
      "@mity-garden/asset-library/*": ["../../packages/asset-library/src/*"],
      "@mity-garden/shared-ui": ["../../packages/shared-ui/src/index.ts"],
      "@mity-garden/shared-ui/*": ["../../packages/shared-ui/src/*"]
    }
  },
  "include": ["src", "App.tsx"],
  "exclude": ["node_modules", ".expo", "android", "ios"]
}
