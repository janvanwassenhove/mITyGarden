# ──────────────────────────────────────────────────────────────────────────────
# mITyGarden — environment variables
#
# Copy this file to apps/web/.env.local and fill in the values.
# VITE_ prefixed variables are embedded in the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# Google Maps API key (optional).
# If set, the wizard location step uses the Google Maps Geocoding API.
# If NOT set, the free OpenStreetMap Nominatim API is used automatically.
#
# Obtain a key at https://console.cloud.google.com/apis/credentials
# Enable the "Geocoding API" and "Maps Static API" for your project.
# Restrict the key to HTTP referrers (your domain) in the Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# OpenAI API key (optional).
# Enables: AI layout suggestions (GPT-4o-mini) + DALL-E 3 image generation.
# Obtain a key at https://platform.openai.com/api-keys
# Restrict to your organisation to prevent unauthorised use.
VITE_OPENAI_API_KEY=

# Anthropic API key (optional, used for text suggestions if OpenAI key is absent).
# Enables: AI layout suggestions (Claude 3 Haiku).
# Obtain a key at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=

# Google Gemini / Imagen API key (optional, used for image generation if OpenAI key is absent).
# Enables: Imagen 3 photorealistic garden image generation.
# Obtain a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
