{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mity-garden/domain": ["../../packages/domain/src/index.ts"],
      "@mity-garden/domain/*": ["../../packages/domain/src/*"],
      "@mity-garden/i18n": ["../../packages/i18n/src/index.ts"],
      "@mity-garden/i18n/*": ["../../packages/i18n/src/*"],
      "@mity-garden/canvas-engine": ["../../packages/canvas-engine/src/index.ts"],
      "@mity-garden/canvas-engine/*": ["../../packages/canvas-engine/src/*"],
      "@mity-garden/asset-library": ["../../packages/asset-library/src/index.ts"],
      "@mity-garden/asset-library/*": ["../../packages/asset-library/src/*"],
      "@mity-garden/persistence": ["../../packages/persistence/src/index.ts"],
      "@mity-garden/persistence/*": ["../../packages/persistence/src/*"],
      "@mity-garden/shared-ui": ["../../packages/shared-ui/src/index.ts"],
      "@mity-garden/shared-ui/*": ["../../packages/shared-ui/src/*"],
      "@mity-garden/maps": ["../../packages/maps/src/index.ts"],
      "@mity-garden/maps/*": ["../../packages/maps/src/*"],
      "@mity-garden/llm": ["../../packages/llm/src/index.ts"],
      "@mity-garden/llm/*": ["../../packages/llm/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
