{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mity-garden/domain": ["../domain/src/index.ts"],
      "@mity-garden/domain/*": ["../domain/src/*"],
      "@mity-garden/asset-library": ["../asset-library/src/index.ts"],
      "@mity-garden/asset-library/*": ["../asset-library/src/*"],
      "@mity-garden/canvas-engine": ["../canvas-engine/src/index.ts"],
      "@mity-garden/canvas-engine/*": ["../canvas-engine/src/*"],
      "@mity-garden/i18n": ["../i18n/src/index.ts"],
      "@mity-garden/i18n/*": ["../i18n/src/*"],
      "@mity-garden/maps": ["../maps/src/index.ts"],
      "@mity-garden/maps/*": ["../maps/src/*"],
      "@mity-garden/llm": ["../llm/src/index.ts"],
      "@mity-garden/llm/*": ["../llm/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}

